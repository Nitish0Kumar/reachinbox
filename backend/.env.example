# ── Server ──────────────────────────────
PORT=5001
ADMIN_TOKEN=reachinbox-admin

# ── PostgreSQL ───────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox_dev_password@localhost:5432/reachinbox

# ── Redis ────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── SMTP (Ethereal for testing) ──────────
# Leave blank to auto-generate a temporary Ethereal account on startup.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password

# ── Slack (optional) ─────────────────────
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Google OAuth (optional) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback
SESSION_SECRET=change-me-in-production

